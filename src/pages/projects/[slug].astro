---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import { getProjects, getSiteData } from '../../lib/content';
import { withBase } from '../../lib/links';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const siteData = await getSiteData();
const { project } = Astro.props;
const { Content } = await project.render();
---
<BaseLayout title={project.data.title} description={project.data.summary} siteData={siteData}>
  <a href={withBase('/projects')} class="inline-flex text-sm font-semibold text-brand-700 hover:text-brand-800">← Back to projects</a>

  <section class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-soft">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">{project.data.status}</p>
    <h1 class="mt-2 text-3xl font-semibold text-slate-900">{project.data.title}</h1>
    {project.data.summary && <p class="mt-3 text-slate-700">{project.data.summary}</p>}

    <ul class="mt-4 flex flex-wrap gap-2">
      {project.data.tags.map((tag) => (
        <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">{tag}</li>
      ))}
    </ul>

    <p class="mt-4 text-sm text-slate-600">Lead(s): {project.data.lead_names.join(', ')}</p>

    <div class="mt-5 flex flex-wrap gap-3">
      {project.data.join_url && (
        <a class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700" href={project.data.join_url} target="_blank" rel="noreferrer">
          Join this project
        </a>
      )}
      {project.data.repo_url && (
        <a class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-700" href={project.data.repo_url} target="_blank" rel="noreferrer">
          Repository
        </a>
      )}
    </div>
  </section>

  <Section title="Project writeup">
    <article class="prose max-w-none rounded-2xl border border-slate-200 bg-white p-6 shadow-soft">
      <Content />
    </article>
  </Section>

  <Section title="Maintain this page">
    <Card>
      Edit <code>src/content/projects/{project.slug}.md</code> to update this project. The route slug and cards update automatically.
    </Card>
  </Section>
</BaseLayout>
