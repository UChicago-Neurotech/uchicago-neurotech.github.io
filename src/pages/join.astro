---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import { getPageById, getSiteData } from '../lib/content';
import { withBase, isExternal } from '../lib/links';

const [siteData, joinEntry] = await Promise.all([getSiteData(), getPageById('join')]);
const { Content } = await joinEntry.render();

const links = [
  siteData.join_links.interest_form,
  siteData.join_links.discord,
  siteData.join_links.mailing_list
];
---
<BaseLayout title={joinEntry.data.title} description={joinEntry.data.description} siteData={siteData}>
  <article class="prose max-w-none rounded-2xl border border-slate-200 bg-white p-6 shadow-soft sm:p-8">
    <Content />
  </article>

  <CardGrid cols="3">
    {links.map((link) => (
      <Card title={link.label}>
        <a
          href={withBase(link.href)}
          class="mt-3 inline-flex rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700"
          target={isExternal(link.href) ? '_blank' : undefined}
          rel={isExternal(link.href) ? 'noreferrer' : undefined}
        >
          Open {link.label}
        </a>
      </Card>
    ))}
  </CardGrid>
</BaseLayout>
