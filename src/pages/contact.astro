---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import { getPageById, getSiteData } from '../lib/content';

const [siteData, contactEntry] = await Promise.all([getSiteData(), getPageById('contact')]);
const { Content } = await contactEntry.render();
const hasFormspree = Boolean(siteData.contact.formspree_endpoint);
---
<BaseLayout title={contactEntry.data.title} description={contactEntry.data.description} siteData={siteData}>
  <article class="prose max-w-none rounded-2xl border border-slate-200 bg-white p-6 shadow-soft sm:p-8">
    <Content />
  </article>

  <section class="mt-10 grid gap-4 lg:grid-cols-2">
    <Card title="Contact Cards">
      <p class="text-sm"><strong>Email:</strong> <a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a></p>
      <ul class="mt-3 space-y-2">
        {siteData.contact.socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noreferrer" class="text-sm font-medium text-brand-700 hover:text-brand-800">
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </Card>

    <Card title={hasFormspree ? 'Send a message' : 'Contact form not enabled'}>
      {hasFormspree ? (
        <form action={siteData.contact.formspree_endpoint} method="POST" class="space-y-3">
          <label class="block text-sm font-medium text-slate-700" for="name">Name</label>
          <input id="name" name="name" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />

          <label class="block text-sm font-medium text-slate-700" for="email">Email</label>
          <input id="email" type="email" name="email" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />

          <label class="block text-sm font-medium text-slate-700" for="message">Message</label>
          <textarea id="message" name="message" rows={5} required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />

          <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700">
            Send message
          </button>
        </form>
      ) : (
        <p>
          Add <code>formspree_endpoint</code> in <code>src/content/site.json</code> to enable this form.
          For now, use <a href={`mailto:${siteData.contact.email}`}>email contact</a>.
        </p>
      )}
    </Card>
  </section>
</BaseLayout>
