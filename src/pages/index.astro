---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../content/site.json';
import projects from '../content/projects.json';
import team from '../content/team.json';
import { withBase } from '../lib/links';

const home = await getEntry('pages', 'home');
const join = await getEntry('pages', 'join');
if (!home || !join) throw new Error('Missing src/content/home.md or join.md');
const { Content: WhatWeDo } = await render(home);
const { Content: Join } = await render(join);
---
<Base>
  {site.banner.show && (
    <p class="banner">
      <a href={site.banner.href} target="_blank" rel="noreferrer">&gt;&gt;&gt; {site.banner.text} &lt;&lt;&lt;</a>
    </p>
  )}

  <header>
    <img src={withBase('/images/branding/logo.svg')} alt="" width="56" height="56" />
    <h1>{site.name}</h1>
  </header>

  <ol class="sections">
    <li>
      <h2>What we do</h2>
      <div class="body"><WhatWeDo /></div>
    </li>

    <li>
      <h2>Projects</h2>
      <ul class="body projects">
        {projects.map((p) => (
          <li>
            <strong>{p.name}{p.description && ':'}</strong> {p.description}
            {p.links.map((l) => <> [<a href={l.href} target="_blank" rel="noreferrer">{l.label}</a>]</>)}
          </li>
        ))}
      </ul>
    </li>

    <li>
      <h2>Who we are</h2>
      <ul class="body team">
        {team.board.map((m) => (
          <li>
            <details>
              <summary>
                {m.link ? <a href={m.link} target="_blank" rel="noreferrer">{m.name}</a> : <strong>{m.name}</strong>}<span class="muted">, {m.role}</span>
              </summary>
              <div class="more">
                <p>Class of {m.year}, {m.majors}</p>
                {m.about.map((a) => <p><span class="label">{a.label}:</span> {a.text}</p>)}
              </div>
            </details>
          </li>
        ))}
      </ul>
      <p class="mentor"><strong>{team.mentor.name}</strong><span class="muted">, {team.mentor.role}</span></p>
    </li>

    <li>
      <h2>Join us</h2>
      <div class="body">
        <Join />
      </div>
    </li>

    <li>
      <h2>Contact</h2>
      <p class="body">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.socials.map((s) => <> [<a href={s.href} target="_blank" rel="noreferrer">{s.label}</a>]</>)}
      </p>
    </li>
  </ol>
</Base>

<style>
  .banner {
    margin-bottom: 3rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  header img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  h1 {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .muted {
    color: var(--muted);
  }

  .sections {
    margin: 0;
    padding-left: 1.75rem;
  }

  .sections > li {
    padding-left: 0.5rem;
  }

  .sections > li + li {
    margin-top: 2.75rem;
  }

  .sections > li::marker {
    color: var(--maroon);
    font-weight: 600;
  }

  h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .body {
    margin-top: 0.85rem;
  }

  .body :global(* + p),
  .body :global(* + ul) {
    margin-top: 0.85rem;
  }

  .body :global(ul) {
    padding-left: 1.1rem;
    list-style: '– ';
  }

  .projects {
    padding-left: 1.1rem;
    list-style: '– ';
  }

  .team {
    padding: 0;
    list-style: none;
  }

  .team > li + li,
  .projects li + li {
    margin-top: 0.4rem;
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: ' [+]';
    color: var(--maroon);
  }

  details[open] summary::after {
    content: ' [–]';
  }

  .more {
    margin: 0.3rem 0 0.6rem 1.5rem;
    color: var(--muted);
  }

  .label {
    color: var(--ink);
  }

  .more p + p {
    margin-top: 0.3rem;
  }

  .mentor {
    margin-top: 0.85rem;
  }
</style>
