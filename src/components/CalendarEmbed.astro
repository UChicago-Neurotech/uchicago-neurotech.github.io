---
interface Props {
  url: string;
  note?: string;
}

const { url, note } = Astro.props;
---
<div class="space-y-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-soft">
  {note && <p class="text-sm text-slate-600">{note}</p>}
  <div class="overflow-hidden rounded-xl border border-slate-200">
    <iframe
      title="Google Calendar"
      src={url}
      class="h-[420px] w-full"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    />
  </div>
</div>
