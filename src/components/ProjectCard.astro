---
import { withBase } from '../lib/links';

interface Props {
  slug: string;
  title: string;
  summary?: string;
  status: 'current' | 'past';
  tags: string[];
  leads: string[];
}

const { slug, title, summary, status, tags, leads } = Astro.props;
---
<article
  class="project-card rounded-2xl border border-slate-200 bg-white p-5 shadow-soft"
  data-status={status}
  data-tags={tags.join('|').toLowerCase()}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">{status}</p>
  <h3 class="mt-2 text-lg font-semibold text-slate-900">
    <a class="hover:text-brand-700" href={withBase(`/projects/${slug}`)}>{title}</a>
  </h3>
  <p class="mt-2 text-sm text-slate-700">{summary ?? 'Replace with project summary in frontmatter.'}</p>
  <p class="mt-3 text-xs text-slate-500">Leads: {leads.join(', ')}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{tag}</li>
    ))}
  </ul>
</article>
