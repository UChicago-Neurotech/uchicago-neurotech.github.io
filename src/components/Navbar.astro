---
import { withBase, isExternal } from '../lib/links';

interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  navigation: LinkItem[];
}

const { siteName, navigation } = Astro.props;
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a class="flex items-center gap-3 text-lg font-semibold tracking-tight text-slate-900" href={withBase('/')}>
      <img
        src={withBase('/images/branding/logo.svg')}
        alt={`${siteName} logo`}
        class="h-9 w-9 object-contain"
        loading="eager"
      />
      <span>{siteName}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-5 md:flex">
      {navigation.map((item) => (
        <a
          href={withBase(item.href)}
          class="text-sm font-medium text-slate-700 transition hover:text-brand-700"
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="group md:hidden">
      <summary class="list-none rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">
        Menu
      </summary>
      <nav aria-label="Mobile" class="absolute right-4 top-14 w-56 rounded-lg border border-slate-200 bg-white p-3 shadow-soft">
        <ul class="space-y-1">
          {navigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100"
                target={isExternal(item.href) ? '_blank' : undefined}
                rel={isExternal(item.href) ? 'noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
